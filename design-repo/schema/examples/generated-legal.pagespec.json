    "title": "Your privacy choices",
    "body": "We use a few small files to keep this site working and, only if you agree, to learn which pages help visitors most. You can change your mind at any time.",
    "inlineLinkLabel": "privacy notice",
    "bannerActions": [
     {
      "label": "Allow all",
      "style": "primary",
      "fsCc": "allow",
      "href": "/#"
     },
     {
      "label": "Choose",
      "style": "outline",
      "fsCc": "open-preferences",
      "href": "/#"
     }
    ],
    "modalActions": [
     {
      "label": "Allow all",
      "style": "primary",
      "fsCc": "allow",
      "href": "/#"
     },
     {
      "label": "Keep my choices",
      "style": "outline",
      "fsCc": "submit",
      "href": "/#"
     }
    ],
