     "Real ones here."
    ],
    "items": [
     {
      "question": "What can AI FOURMULA create for my brand?",
      "answer": "Product images, fashion shots, lifestyle scenes and short videos for PDPs, social, ads and email.",
      "icon": "+"
     },
     {
      "question": "What do I need to start?",
      "answer": "Just a store link or a product photo. We use it to generate on-brand visuals automatically.",
      "icon": "+"
     },
     {
      "question": "Will the visuals match our brand look?",
      "answer": "Yes. We learn from your existing images and keep colours, lighting and style consistent.",
      "icon": "+"
     },
     {
      "question": "Do I own the assets you generate?",
      "answer": "Yes. All approved outputs are yours to use across any channel.",
      "icon": "+"
     },
     {
      "question": "How fast do I get results?",
      "answer": "Usually in seconds or a few minutes, depending on how many assets you request.",
      "icon": "+"
     },
     {
      "question": "Does this replace my creative team?",
      "answer": "No. It speeds up production so your team can focus on ideas, not manual reshoots and cropping.",
      "icon": "+"
     }
    ]
   },
