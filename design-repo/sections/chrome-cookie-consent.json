      },
      "inlineLinkLabel": {
        "type": "string",
        "maxWords": 3,
        "note": "Measured: 2 words, \"privacy policy\"."
      },
      "bannerActions": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 3
            },
            "style": {
              "type": "string",
              "enum": [
                "primary",
                "outline"
              ]
            },
            "fsCc": {
              "type": "string",
              "enum": [
                "allow",
                "open-preferences",
                "submit",
                "close"
              ]
            },
            "href": {
              "type": "string",
              "format": "route-or-inert-hash"
            }
          },
          "required": [
            "label",
            "style",
            "fsCc",
            "href"
          ]
        },
        "note": "Exactly 2: \"Accept all\" (primary, fs-cc=allow) and \"Settings\" (outline, fs-cc=open-preferences)."
      },
      "modalActions": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 3
            },
            "style": {
              "type": "string",
              "enum": [
                "primary",
                "outline"
              ]
            },
            "fsCc": {
              "type": "string",
              "enum": [
                "allow",
                "open-preferences",
                "submit",
                "close"
              ]
            },
            "href": {
              "type": "string",
              "format": "route-or-inert-hash"
            }
          },
          "required": [
            "label",
            "style",
            "fsCc",
            "href"
          ]
        },
        "note": "Exactly 2: \"Accept all\" (primary, fs-cc=allow) and \"Save changes\" (outline, fs-cc=submit)."
      },
      "categories": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 5
            },
            "description": {
              "type": "string",
              "maxWords": 22,
              "bodyCopy": true
            },
            "interactive": {
              "type": "boolean"
            },
            "fsCcCheckbox": {
              "type": "string",
              "enum": [
                "marketing",
                "personalization",
                "analytics",
                "necessary"
              ]
            },
            "assetRole": {
              "type": "string",
              "enum": [
                "form-control-checkmark"
              ]
            }
          },
          "required": [
            "label",
            "description",
            "interactive",
            "fsCcCheckbox"
          ]
        },
        "note": "Exactly 4. Measured labels 1-4 words, descriptions 7-21 words. Only the first is non-interactive (\"Strictly necessary (always active)\")."
      },
      "closeLabel": {
        "type": "string",
        "maxWords": 5,
        "note": "Measured: \"Close cookies modal\" (3) on the banner, \"Close Cookie Preference Manager\" (4) in the modal; both are screen-reader-only."
      }
    },
    "required": [
      "title",
      "body",
      "bannerActions",
      "modalActions",
      "categories"
    ]
