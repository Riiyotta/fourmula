{
  "id": "chrome.cookie-consent",
  "kind": "section",
  "category": "chrome",
  "purpose": "The vendored Finsweet Cookie Consent banner and preference modal. Rendered unconditionally on EVERY route.",
  "content": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "maxWords": 3,
        "note": "Measured: 2 words, \"Cookie settings\", on both the banner and the modal."
      },
      "body": {
        "type": "string",
        "maxWords": 32,
        "note": "Measured: 30 words, identical on the banner and the modal, containing one inline privacy-policy link.",
