{
  "$description": "16 fluid type steps plus one family and two weights. Every step is declared three times in src/styles/fourmula-base.css - in :root (2094-2127) for the base tier, in body inside @media (max-width:991px) (4766-4784) and in body inside @media (max-width:767px) (5140-5158). The .u-<name> utility classes at 2298-2412, 3829-3833 and 4105-4109 bind each step to a family and a weight.",
  "idConvention": "Token ids are dotted, lower-case, tier-prefix-free. Foundation ids are <category>.<name> (color.mainbg-dark, type.h1, spacing.1, radius.md, breakpoint.tablet, elevation.z-header, icon-size.header-logo, motion.transition.fast). Semantic ids are <role>.<variant> (text.primary, surface.page, border.hairline, accent.primary). Component ids start with component.<name>.<slot>, layout ids with layout.<name>. A \"$ref\" is always another token id.",
  "ROOT_FONT_SIZE_IS_FLUID": {
    "warning": "THE SINGLE MOST IMPORTANT STRUCTURAL FACT IN THIS PROJECT. Every rem above scales with the viewport because the root font-size is itself a viewport-width function. A design-repo consumer that multiplies these rem values by 16 will be wrong at EVERY viewport.",
    "declaration": "html { font-size: calc(1.484375rem * var(--user-zoom)); }",
    "mediaOverrides": {
      "max-width:2560px": "calc((-0.006009615384615419rem + 0.9314903846153846vw) * var(--user-zoom))",
      "max-width:1728px": "calc((-0.009345794392523143rem + 0.9345794392523362vw) * var(--user-zoom))",
      "max-width:991px": "calc((0.021640258215962493rem + 1.8779342723004695vw) * var(--user-zoom))",
      "max-width:767px": "calc((-0.0025905678851174934rem + 4.14490861618799vw) * var(--user-zoom))"
    },
    "userZoom": "--user-zoom defaults to 1 (index.html:7 and fourmula-base.css/head.css :root) and is driven by public/motion/m06.js via localStorage key site-user-zoom in steps of 0.1.",
    "workedExample": "At a 1920px viewport the 2560px branch applies: 0.9314903846153846 * 19.20 - 0.006009615384615419 * 16 = 17.7885px, i.e. 1.11178x the 16px default.",
    "measuredRealValues": {
      "1440px": "13.3084px",
      "390px": "16.1237px",
      "note": "Measured identically on the live original and on this clone."
    },
    "evidence": [
      "cit-type-fluid-root",
      "cit-type-fluid-media",
      "cit-type-userzoom",
      "cit-type-fluid-measured"
    ]
  },
